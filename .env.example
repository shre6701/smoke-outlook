# Copy to .env and fill in. Never commit .env.

# --- Needed now (Stage 1) ---
# NASA FIRMS fire detections. Sign up: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# data.gov.in (CPCB station feed). Sign up: https://www.data.gov.in/user/register  (key is under "My Account")
DATAGOV_API_KEY=

# --- Needed before Stage 3 ---
# XKDR Forum India Air Quality Database (free, about a minute). Sign up: https://airquality.xkdr.org/signup
XKDR_API_KEY=

# --- Optional ---
# OpenAQ v3. Sign up: https://explore.openaq.org/register
OPENAQ_API_KEY=

# --- Later (v2: agent) ---
# NVIDIA API catalog. Sign up: https://build.nvidia.com/
NVIDIA_API_KEY=
# Any OpenAI-compatible provider. Code reads only these three.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=
LLM_API_KEY=

# --- Later (v3: parallel hindcasts) ---
# Databricks Free Edition. Sign up: https://www.databricks.com/learn/free-edition
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# --- Local services (user/db/port defaults work; password has no default) ---
POSTGRES_USER=smoke
# Required: pick any strong local password (no default in docker-compose).
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smoke
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
KAFKA_BOOTSTRAP=localhost:9092
